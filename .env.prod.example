# PRODUÇÃO — copie para .env.prod NA VM. Nunca commite o arquivo preenchido.
# Subir:  docker compose -p tcc-prod --env-file .env.prod -f docker-compose.prod.yml up -d

ENV_NAME=prod

IMAGE_API=ghcr.io/SEU_USUARIO/bookish-octo-waffle/api
IMAGE_CLIENT=ghcr.io/SEU_USUARIO/bookish-octo-waffle/client
IMAGE_TAG=latest

POSTGRES_USER=tcc
# openssl rand -base64 24
POSTGRES_PASSWORD=
POSTGRES_DB=tcc

# openssl rand -base64 48  — PRECISA ser diferente do staging
# Minimo 32 caracteres: a API se recusa a subir com segredo curto ou ausente.
JWT_SECRET=

FRONTEND_URL=https://app.seudominio.me
ALLOWED_EMAIL_DOMAINS=catolicasc.edu.br,catolicasc.org.br

AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_REDIRECT_URI=https://app.seudominio.me/api/auth/microsoft/callback

# openssl rand -base64 32  — se mudar depois, os refresh tokens do OneDrive
# ja guardados viram lixo indecifravel. Gere UMA vez e guarde.
TOKEN_ENC_KEY=
ONEDRIVE_BASE_FOLDER=Parcerias
ONEDRIVE_TEMPLATES_FOLDER=Templates
ONEDRIVE_CONTRACTS_FOLDER=Contratos

SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Catolica SC <noreply@catolicasc.edu.br>

CONTRACT_JOB_POLL_MS=2000
CONTRACT_JOB_MAX_ATTEMPTS=3
