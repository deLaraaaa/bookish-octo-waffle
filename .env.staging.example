# STAGING — copie para .env.staging NA VM. Nunca commite o arquivo preenchido.
# Subir:  docker compose -p tcc-staging --env-file .env.staging -f docker-compose.prod.yml up -d

ENV_NAME=staging

IMAGE_API=ghcr.io/SEU_USUARIO/bookish-octo-waffle/api
IMAGE_CLIENT=ghcr.io/SEU_USUARIO/bookish-octo-waffle/client
IMAGE_TAG=staging

POSTGRES_USER=tcc
# openssl rand -base64 24
POSTGRES_PASSWORD=
POSTGRES_DB=tcc
# Porta do banco no loopback da VM (túnel SSH). Diferente entre prod e staging.
PG_HOST_PORT=5435

# openssl rand -base64 48  — PRECISA ser diferente da producao
# Minimo 32 caracteres: a API se recusa a subir com segredo curto ou ausente.
JWT_SECRET=

FRONTEND_URL=https://staging.seudominio.me
ALLOWED_EMAIL_DOMAINS=catolicasc.edu.br,catolicasc.org.br

AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_REDIRECT_URI=https://staging.seudominio.me/api/auth/microsoft/callback

# openssl rand -base64 32  — se mudar depois, os refresh tokens do OneDrive
# ja guardados viram lixo indecifravel. Gere UMA vez e guarde.
TOKEN_ENC_KEY=
ONEDRIVE_BASE_FOLDER=Parcerias-Staging
ONEDRIVE_TEMPLATES_FOLDER=Templates
ONEDRIVE_CONTRACTS_FOLDER=Contratos

# SMTP_HOST vazio de proposito: em staging o codigo 2FA vai para o log do
# container em vez do e-mail. Veja com:
#   docker compose -p tcc-staging logs api | grep two_factor_code_dev
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

CONTRACT_JOB_POLL_MS=2000
CONTRACT_JOB_MAX_ATTEMPTS=3
