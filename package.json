{
  "scripts": {
    "start": "docker compose up -d --build",
    "start:docker": "docker compose up -d --build",
    "stop": "docker compose down",
    "restart": "docker compose up -d --build --force-recreate",
    "logs": "docker compose logs -f api",
    "dev:api": "node --watch server/server.js",
    "test:smtp": "node server/scripts/test-smtp.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:coverage:gate": "vitest run --coverage --coverage.thresholds.lines=75 --coverage.thresholds.statements=75"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^6.9.14",
    "pg": "^8.20.0"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^2.1.9",
    "vitest": "^2.1.9"
  }
}
