# Ambiente LOCAL (docker compose up). Copie para .env e preencha.

DATABASE_URL=postgres://postgres:postgres@localhost:5433/tcc
PORT=4000

# Gere com: openssl rand -base64 48
# Minimo 32 caracteres: a API se recusa a subir com segredo curto ou ausente.
JWT_SECRET=

FRONTEND_URL=http://localhost:3000
ALLOWED_EMAIL_DOMAINS=catolicasc.edu.br,catolicasc.org.br

AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_REDIRECT_URI=http://localhost:4000/auth/microsoft/callback

# Gere com: openssl rand -base64 32   (exatamente 32 bytes)
TOKEN_ENC_KEY=
ONEDRIVE_BASE_FOLDER=Parcerias
ONEDRIVE_TEMPLATES_FOLDER=Templates
ONEDRIVE_CONTRACTS_FOLDER=Contratos

# Sem SMTP_HOST o código 2FA vai para o log em vez do e-mail (modo dev)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

CONTRACT_JOB_POLL_MS=2000
CONTRACT_JOB_MAX_ATTEMPTS=3
